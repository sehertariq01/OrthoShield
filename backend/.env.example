# OrthoShield Environment Configuration Template
# Copy this file to .env and configure values for your environment.

# JWT Signing Secret Key (generate with: openssl rand -hex 32)
ORTHOSHIELD_SECRET_KEY=your_64_character_random_secret_key_here

# ClamAV Antivirus Daemon (running in WSL2 or local container)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# VirusTotal API Key (free tier API key from https://www.virustotal.com)
VT_API_KEY=your_virustotal_api_key_here

# Orthanc PACS Integration
ORTHANC_URL=http://localhost:9042
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=orthanc
